<UserControl x:Class="VertaIT.WPF.NetDemo.Views.ObjectPanels.DatePickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="263.281"
             d:DesignWidth="449.219"
             Name="DatePicker"
             mc:Ignorable="d">
	<StackPanel Width="250"
	            HorizontalAlignment="Left"
	            Orientation="Vertical">
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Default (short date format)" />
		<DatePicker Margin="0,0,0,12" />
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Long date format" />
		<DatePicker Margin="0,0,0,12"
		            SelectedDateFormat="Long" />
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Disabled" />
		<DatePicker Margin="0,0,0,12"
		            IsEnabled="False" />
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Disabled (long date format)" />
		<DatePicker Margin="0,0,0,12"
		            IsEnabled="False"
		            SelectedDateFormat="Long" />
	</StackPanel>
</UserControl>
