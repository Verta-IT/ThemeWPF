<UserControl x:Class="VertaIT.WPF.Demo.Views.ObjectPanels.NumericUpDownPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:VertaIT.WPF.Theme.Controls;assembly=VertaIT.WPF.Theme"
             d:DesignHeight="263.281"
             d:DesignWidth="449.219"
             Name="NumericUpDown"
             mc:Ignorable="d">
	<StackPanel Width="250"
	            HorizontalAlignment="Left"
	            Orientation="Vertical">
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Default (0 to 100)" />
		<controls:NumericUpDown x:Name="defaultNumericUpDown"
		                        Margin="0,0,0,4" />
		<TextBlock Margin="0,0,0,12"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="{Binding Value, ElementName=defaultNumericUpDown, StringFormat=Value: {0}}" />
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Decimal places (-10 to 10, step 0.25)" />
		<controls:NumericUpDown Margin="0,0,0,12"
		                        DecimalPlaces="2"
		                        LargeChange="1"
		                        Maximum="10"
		                        Minimum="-10"
		                        SmallChange="0.25"
		                        Value="2.5" />
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Read only" />
		<controls:NumericUpDown Margin="0,0,0,12"
		                        IsReadOnly="True"
		                        Value="42" />
		<TextBlock Margin="0,0,0,4"
		           FontWeight="SemiBold"
		           Style="{DynamicResource TextBlockStyle}"
		           Text="Disabled" />
		<controls:NumericUpDown Margin="0,0,0,12"
		                        IsEnabled="False"
		                        Value="7" />
	</StackPanel>
</UserControl>
